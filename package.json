    "stack-utils": "*",
    "strip-ansi": "*",
    "supports-hyperlinks": "*",
    "tree-kill": "*",
    "turndown": "^7.2.4",
    "type-fest": "*",
    "undici": "*",
    "url-handler-napi": "file:./shims/url-handler-napi",
    "usehooks-ts": "*",
    "vscode-jsonrpc": "*",
